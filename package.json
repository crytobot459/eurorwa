{
  "name": "eurorwa",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "fetch": "bun run src/fetch.ts",
    "ingest": "bun run src/ingest.ts",
    "api": "bun run src/api.ts",
    "attest": "bun run src/agent/attest.ts",
    "verify": "bun run src/agent/verify.ts",
    "deploy": "bun run src/agent/deploy.ts",
    "publish": "bun run src/agent/publish.ts",
    "analyst": "bun --env-file=.env.local run src/analyst/index.ts",
    "alerts": "bun --env-file=.env.local run scripts/alerts.ts",
    "onchain": "bun run src/verify/index.ts",
    "rotation": "bun run src/analyst/rotation.ts",
    "portfolio": "bun run src/analyst/portfolio.ts",
    "strategy": "bun run src/analyst/strategy.ts",
    "axis-test": "bun run scripts/axis-test.js",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4",
    "viem": "^2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "solc": "^0.8.36",
    "typescript": "^5.9.2"
  }
}
