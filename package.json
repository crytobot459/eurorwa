{
  "name": "eurorwa",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "fetch": "bun run src/fetch.ts",
    "ingest": "bun run src/ingest.ts",
    "api": "bun run src/api.ts",
    "attest": "bun run src/agent/attest.ts",
    "verify": "bun run src/agent/verify.ts",
    "deploy": "bun run src/agent/deploy.ts",
    "publish": "bun run src/agent/publish.ts",
    "posts": "bun run src/posts.ts",
    "visual": "bun run src/visual.ts",
    "analyst": "bun --env-file=.env.local run src/analyst/index.ts",
    "frontend": "cd src/frontend && bun run dev",
    "freelance": "bun --env-file=.env.local run scripts/freelance-bot.js",
    "freelance-test": "bun run scripts/freelance-test.js",
    "typecheck": "bunx tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4",
    "viem": "^2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "solc": "^0.8.36",
    "typescript": "^5.9.2"
  }
}
