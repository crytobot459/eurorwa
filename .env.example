# EuroRWA — environment (ALL FIELDS OPTIONAL)
#
# The research pipeline runs with NO keys: it scrapes public rwa.xyz fund
# pages and reads on-chain supply from public RPC. You only need keys for
# optional features. Nothing here is required to fetch, attest, or serve data.

# --- Data sources (optional) ---
# Raises the Etherscan rate limit from 5 req/s. The pipeline works without it.
ETHERSCAN_API_KEY=

# --- Analyst / LLM summaries (optional) ---
# Free Gemini key from aistudio.google.com — used only by src/analyst for
# natural-language market views. Leave empty to skip LLM summaries.
GEMINI_API_KEY=

# OpenAI-compatible fallback used when GEMINI_API_KEY is unset / rate-limited.
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_TOKENS=
LLM_MIN_GAP_MS=

# --- Telegram data bot (optional) ---
# Only needed if you run the /api/tg webhook. The data API itself needs no bot.
TG_TOKEN=

# --- On-chain attestation (optional) ---
# The attestation signer. If unset, attest.ts auto-generates a local wallet
# at data/agent.key (gitignored, never funded). You do NOT need a real key.
AGENT_PRIVATE_KEY=
