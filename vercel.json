{
  "framework": null,
  "installCommand": "bun install",
  "buildCommand": "cd src/frontend && bun install && node node_modules/vite/bin/vite.js build",
  "build": {
    "env": {
      "VITE_API": "/api"
    }
  },
  "rewrites": [
    { "source": "/mcp", "destination": "/api/main" },
    { "source": "/openapi.json", "destination": "/.well-known/openapi.json" },
    { "source": "/api/:path*", "destination": "/api/main" }
  ]
}
