{
  "openapi": "3.0.3",
  "info": {
    "title": "EuroRWA API",
    "description": "Tokenized money-market fund (RWA) analysis. Open endpoints for dashboard data; a paid x402 endpoint (POST /api/analyst) returns the latest analyst report with BUY/HOLD/SELL signals, hashed, signed and attested on-chain (Sepolia).",
    "version": "1.0.0"
  },
  "servers": [{ "url": "https://rwa-dashboard-gamma.vercel.app" }],
  "paths": {
    "/api/overview": {
      "get": {
        "operationId": "getOverview",
        "summary": "Latest analyst report summary",
        "description": "Date, market/crypto/chain views, BUY/HOLD/SELL signals, on-chain verification status.",
        "responses": {
          "200": {
            "description": "Report summary",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "date": { "type": "string", "description": "Report date YYYY-MM-DD" },
                    "generated_at": { "type": "string", "format": "date-time" },
                    "market_view": { "type": "string" },
                    "crypto_view": { "type": "string" },
                    "chain_view": { "type": "string" },
                    "signals": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ticker": { "type": "string" },
                          "action": { "type": "string", "enum": ["BUY", "HOLD", "SELL"] },
                          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
                          "reasons": { "type": "array", "items": { "type": "string" } }
                        }
                      }
                    },
                    "macro": { "type": "string" },
                    "crypto": { "type": "string" },
                    "chain": { "type": "string" },
                    "signer": { "type": "string" },
                    "hash": { "type": "string" },
                    "verified": { "type": "boolean" },
                    "attestation": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string" },
                        "tx": { "type": "string" },
                        "block": { "type": "number" },
                        "hash": { "type": "string" },
                        "signer": { "type": "string" }
                      }
                    },
                    "snapshot": {
                      "type": "object",
                      "properties": {
                        "date": { "type": "string" },
                        "fetched_at": { "type": "string", "format": "date-time" },
                        "age_hours": { "type": "number" },
                        "lag": { "type": "string", "enum": ["fresh", "stale", "old"] }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/funds": {
      "get": {
        "operationId": "getFunds",
        "summary": "Per-fund table",
        "description": "All tracked funds sorted by TVL, with NAV and integrity checks.",
        "responses": {
          "200": {
            "description": "Funds table",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "date": { "type": "string" },
                    "snapshot": { "$ref": "#/components/schemas/Snapshot" },
                    "integrity": {
                      "type": "object",
                      "properties": {
                        "checked": { "type": "number" },
                        "ok": { "type": "number" },
                        "warn": { "type": "number" },
                        "fail": { "type": "number" }
                      }
                    },
                    "funds": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Fund" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/funds/{slug}": {
      "get": {
        "operationId": "getFund",
        "summary": "Single fund with history",
        "description": "Fund metadata plus full TVL / yield / holders / supply history.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Fund slug, e.g. circle-usyc"
          }
        ],
        "responses": {
          "200": {
            "description": "Fund and history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "fund": {
                      "type": "object",
                      "properties": {
                        "slug": { "type": "string" },
                        "ticker": { "type": "string" },
                        "name": { "type": "string" },
                        "issuer": { "type": "string" },
                        "asset_class": { "type": "string" }
                      }
                    },
                    "history": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": { "type": "string" },
                          "tvl": { "type": "number", "nullable": true },
                          "chg_7d_pct": { "type": "number", "nullable": true },
                          "yield": { "type": "number", "nullable": true },
                          "holders": { "type": "number", "nullable": true },
                          "supply": { "type": "number", "nullable": true }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Fund not found" }
        }
      }
    },
    "/api/yields": {
      "get": {
        "operationId": "getYields",
        "summary": "Yield ranking",
        "description": "Funds sorted by yield, highest first.",
        "responses": {
          "200": {
            "description": "Yield ranking",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "date": { "type": "string" },
                    "yields": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ticker": { "type": "string" },
                          "slug": { "type": "string" },
                          "yield": { "type": "number" },
                          "date": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/flows": {
      "get": {
        "operationId": "getFlows",
        "summary": "Day-over-day flows",
        "description": "TVL change for each fund versus the previous snapshot.",
        "responses": {
          "200": {
            "description": "Flows",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "date": { "type": "string" },
                    "prev_date": { "type": "string", "nullable": true },
                    "flows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ticker": { "type": "string" },
                          "slug": { "type": "string" },
                          "flow": { "type": "number", "nullable": true },
                          "tvl": { "type": "number" },
                          "chg_7d_pct": { "type": "number" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/analytics": {
      "get": {
        "operationId": "getAnalytics",
        "summary": "Institutional metrics",
        "description": "Concentration (HHI, top-N share), breadth (yield spread), currency split, chains, issuers, holders, day flows.",
        "responses": {
          "200": {
            "description": "Analytics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "date": { "type": "string" },
                    "prev_date": { "type": "string", "nullable": true },
                    "total_tvl": { "type": "number" },
                    "fund_count": { "type": "number" },
                    "concentration": {
                      "type": "object",
                      "properties": {
                        "top3_pct": { "type": "number" },
                        "top5_pct": { "type": "number" },
                        "top10_pct": { "type": "number" },
                        "hhi": { "type": "number" }
                      }
                    },
                    "breadth": {
                      "type": "object",
                      "properties": {
                        "yield_funds": { "type": "number" },
                        "median_yield": { "type": "number", "nullable": true },
                        "max_yield": { "type": "number", "nullable": true },
                        "min_yield": { "type": "number", "nullable": true },
                        "spread": { "type": "number", "nullable": true }
                      }
                    },
                    "currency": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "tvl": { "type": "number" },
                          "count": { "type": "number" },
                          "share": { "type": "number" }
                        }
                      }
                    },
                    "chains": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "tvl": { "type": "number" },
                          "count": { "type": "number" },
                          "share": { "type": "number" }
                        }
                      }
                    },
                    "issuers": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": { "type": "string" },
                          "tvl": { "type": "number" },
                          "count": { "type": "number" },
                          "share": { "type": "number" }
                        }
                      }
                    },
                    "holders": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "number" },
                        "avg": { "type": "number", "nullable": true }
                      }
                    },
                    "day_flows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ticker": { "type": "string" },
                          "flow": { "type": "number", "nullable": true }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/alerts": {
      "get": {
        "operationId": "getAlerts",
        "summary": "Recent alerts",
        "description": "Yield breakouts, TVL spikes, holder surges, regime flips.",
        "responses": {
          "200": {
            "description": "Alerts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "updated_at": { "type": "string", "format": "date-time", "nullable": true },
                    "alerts": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": { "type": "string" },
                          "type": { "type": "string" },
                          "severity": { "type": "string", "enum": ["info", "warning", "critical"] },
                          "ticker": { "type": "string" },
                          "title": { "type": "string" },
                          "detail": { "type": "string" },
                          "date": { "type": "string" }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/analyst": {
      "post": {
        "operationId": "getAnalystReport",
        "summary": "Latest analyst report (paid)",
        "description": "x402 pay-per-call: $0.05 USDC on Base (eip155:8453), 6 decimals = 50000 atomic units, payTo 0x02B027ecd3004Fbb579bD4c64B6e22Fff369F846. First call without payment returns 402 with a PAYMENT-REQUIRED header; resend with the PAYMENT-SIGNATURE header (base64 JSON of { x402Version: 2, accepted, payload: { signature, authorization } }).",
        "responses": {
          "200": {
            "description": "Full analyst report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "date": { "type": "string" },
                    "generated_at": { "type": "string", "format": "date-time" },
                    "market_view": { "type": "string" },
                    "crypto_view": { "type": "string" },
                    "chain_view": { "type": "string" },
                    "signals": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "ticker": { "type": "string" },
                          "action": { "type": "string", "enum": ["BUY", "HOLD", "SELL"] },
                          "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
                          "reasons": { "type": "array", "items": { "type": "string" } }
                        }
                      }
                    },
                    "hash": { "type": "string" },
                    "signer": { "type": "string" },
                    "signature": { "type": "string" },
                    "attestation": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string" },
                        "tx": { "type": "string" },
                        "block": { "type": "number" },
                        "hash": { "type": "string" },
                        "signer": { "type": "string" }
                      }
                    }
                  },
                  "required": ["date", "market_view", "signals", "hash", "signer", "signature"]
                }
              }
            }
          },
          "402": {
            "description": "Payment required. PAYMENT-REQUIRED header (base64 JSON) describes the accepted x402 payment."
          },
          "503": { "description": "No report available yet" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Snapshot": {
        "type": "object",
        "properties": {
          "date": { "type": "string" },
          "fetched_at": { "type": "string", "format": "date-time" },
          "age_hours": { "type": "number" },
          "lag": { "type": "string", "enum": ["fresh", "stale", "old"] }
        }
      },
      "Fund": {
        "type": "object",
        "properties": {
          "slug": { "type": "string" },
          "ticker": { "type": "string" },
          "name": { "type": "string" },
          "issuer": { "type": "string" },
          "asset_class": { "type": "string" },
          "tvl": { "type": "number" },
          "tvl_7d": { "type": "number" },
          "chg_7d_pct": { "type": "number" },
          "yield": { "type": "number" },
          "holders": { "type": "number" },
          "supply": { "type": "number" },
          "nav": { "type": "number", "nullable": true },
          "integrity": { "type": "string", "enum": ["ok", "warn", "fail", "na"] },
          "checks": {
            "type": "object",
            "properties": {
              "self": { "type": "boolean" },
              "nav": { "type": "boolean" },
              "yield": { "type": "boolean" }
            }
          },
          "date": { "type": "string" }
        }
      }
    }
  }
}
