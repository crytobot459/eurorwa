{
  "x402Version": 2,
  "name": "EuroRWA Analyst API",
  "description": "Tokenized money-market fund analysis. Returns the latest analyst report: BUY/HOLD/SELL signals per fund, market view, crypto market brief and on-chain brief. Every report is hashed, signed and attested on-chain (Sepolia), so it can be independently verified.",
  "network": "base",
  "facilitator": "coinbase",
  "payTo": "0x02B027ecd3004Fbb579bD4c64B6e22Fff369F846",
  "services": [
    {
      "method": "POST",
      "path": "/api/analyst",
      "description": "Latest EuroRWA analyst report (signals + market/crypto/chain views + on-chain proof)",
      "amount": "50000",
      "discoverable": true,
      "outputSchema": {
        "input": {
          "type": "http",
          "method": "POST",
          "bodyFields": {}
        },
        "output": {
          "type": "json",
          "schema": {
            "date": { "type": "string" },
            "market_view": { "type": "string" },
            "crypto_view": { "type": "string" },
            "chain_view": { "type": "string" },
            "signals": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "ticker": { "type": "string" },
                  "action": { "type": "string", "enum": ["BUY", "HOLD", "SELL"] },
                  "confidence": { "type": "string" },
                  "reasons": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "hash": { "type": "string" },
            "signer": { "type": "string" },
            "signature": { "type": "string" },
            "attestation": {
              "type": "object",
              "properties": {
                "key": { "type": "string" },
                "tx": { "type": "string" },
                "block": { "type": "number" }
              }
            }
          }
        }
      }
    }
  ]
}
